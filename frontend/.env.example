# =============================================================================
# GetCito — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# AI API Keys (users can provide their own)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Agent (in-product BYOK)
# -----------------------------------------------------------------------------
# Cloud customers paste their own AI provider keys in Settings › AI
# Providers. We encrypt them at rest with AES-256-GCM; this is the master key. Must be a
# 32-byte (256-bit) value, base64-encoded.
#   Generate one: `openssl rand -base64 32`
# Self-host instances can skip this — they use ANTHROPIC_API_KEY directly.
GETCITO_ENCRYPTION_KEY=base64-32-bytes-here
PERPLEXITY_API_KEY=pplx-...
GROK_API_KEY=xai-...

# -----------------------------------------------------------------------------
# App
# Use https://getcito.com for the GetCito production deployment.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Disable Next.js CLI telemetry for development and builds.
NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# Cloud / Self-hosted mode
# Set to "true" only for the official cloud deployment.
# Self-hosted instances should leave this unset or "false" — all features
# will be unlocked automatically.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_IS_CLOUD=false

# -----------------------------------------------------------------------------
# Action Center: show "Regenerate tasks" in an action's Tasks tab (AC-004).
# Set to "true" together with the server's ACTION_TASKS_AI.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ACTION_TASKS_AI=

# -----------------------------------------------------------------------------
# Content Editor Quality (Drive quality spec): which phase is live, 0 (unset)
# for none. 1 shows Instructions › Quality and the header's Quality chip.
# 2 adds the AI checks, starting with the site type picked in the editor
# (CE-056); set the server's CONTENT_QUALITY_PHASE to the same value, so the
# Content Agent is told it too. 3 weighs the checks by the page's type (a
# product page has no author, a comparison wants balance; CE-052).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTENT_QUALITY_PHASE=

# -----------------------------------------------------------------------------
# Chat: the new Chat (Drive Chat specs, CHAT-00…25), off unless "true".
# Off, today's /dashboard/agent stays as it is. Read by server code at
# request time (not NEXT_PUBLIC_, so never in the browser's code); a change
# applies once the app starts again: a restart when self-hosted, a new
# deployment on Vercel. Set the server's CHAT_AGENTIC and CHAT_AGENTIC_ORGS
# to the same values.
# CHAT_AGENTIC_ORGS: with Chat on, only these organizations (ids,
# comma-separated); empty = every organization.
# With Chat on, a workspace without its own key (own keys: Growth and
# Enterprise, or a Starter key saved before) runs Chat on ANTHROPIC_API_KEY
# above, and each model step draws on its monthly AI budget through the
# server's internal endpoints (CRON_SECRET below).
# -----------------------------------------------------------------------------
CHAT_AGENTIC=
CHAT_AGENTIC_ORGS=
# STAFF_EMAILS: GetCito staff, by sign-in e-mail (comma-separated, any
# case). With Chat on, they get the Debug switch in a chat's ⋯ menu: each
# answer's tools, inputs, outputs, tokens and cost (CHAT-03 items 25–26),
# and Chat's design preview at /dashboard/chat/preview (404 for anyone else).
# Empty = nobody. Server only, like CHAT_AGENTIC; each Debug view is logged.
STAFF_EMAILS=
# Chat's agents: the API server's minute cron and signal hook call this app's
# /api/internal/chat/agents/* endpoints with
# "Authorization: Bearer ${CHAT_INTERNAL_SECRET}". Set the server's
# CHAT_INTERNAL_SECRET to the same value; unset, those calls are refused (401)
# and agents run only by Run now. Generate: openssl rand -hex 32
CHAT_INTERNAL_SECRET=
# The other way: an agent's triggered run has no one's session, so this
# app's writes through the API server for it (an opportunity's status, a
# dismissed prompt suggestion, Send to Action Center and its duplicate
# check) send "Authorization: Bearer ${CHAT_ACTING_SECRET}" and
# "X-Acting-User: <the member's id>". A secret of its own, not
# CHAT_INTERNAL_SECRET's value; set the server's CHAT_ACTING_SECRET to the
# same value. At least 32 characters; unset or shorter, or a value that
# differs from the server's (it answers 401), those changes ask first in such
# a run, on a card in the owner's Inbox.
# Generate: openssl rand -hex 32
CHAT_ACTING_SECRET=
# Chat's skill import from a GitHub link (W3-09b): a fine-grained token with
# no permissions, which reads public repositories only. Optional: unset, the
# import asks GitHub's API anonymously (60 requests an hour per server).
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# GetCito Server (backend API)
# -----------------------------------------------------------------------------
# Public API origin for server requests and the tracking code copied into sites.
NEXT_PUBLIC_API_URL=http://localhost:80

# -----------------------------------------------------------------------------
# Cron / Internal-endpoint secret (cloud, and self-hosted with Chat on)
# -----------------------------------------------------------------------------
# Shared secret that authenticates calls from the web layer to the server's
# internal endpoints. Used by:
#   - Vercel Cron  →  /api/cron/daily-tracking
#   - Stripe success route  →  post-checkout tracking trigger
#   - MCP layer  →  content-brief generation (throws if unset)
#   - Chat (CHAT_AGENTIC)  →  each model step's AI budget; without it Chat
#     can't answer, self-hosted too
# Web sends:  Authorization: Bearer ${CRON_SECRET}
# Server checks its own CRON_SECRET copy — both values MUST match.
# Generate: openssl rand -hex 32
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Stripe (cloud only — not needed for self-hosted)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
# STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
# Annual prices (a year up front, 20% off twelve months: Starter $470, Growth
# $2,390 — the amounts in frontend/src/config/plans.ts). Without them the Billing
# page's Annual choice can't be bought.
# STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
# STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...
# The first-month offer with "Buy now": 50% off a monthly plan's first month
# through the SAVE50 promotion code (FIRST_MONTH_OFFER in
# frontend/src/config/plans.ts). On unless set to `off`; off, every plan button
# and line shows the plain price. End the code in Stripe as well.
# NEXT_PUBLIC_FIRST_MONTH_OFFER=

# -----------------------------------------------------------------------------
# Supabase Service Role Key (cloud only — for Stripe webhooks)
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
